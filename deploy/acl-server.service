; AnotherCrewLink signalling server (Rust).
;
; Install to /etc/systemd/system/acl-server.service. Every directive below carries a
; comment saying what it prevents, because a unit file nobody understands is a unit file
; that gets deleted the first time something breaks.
;
; See deploy/README.md for the user, the directories, the environment file and the
; reverse-proxy configuration this unit assumes.

[Unit]
Description=AnotherCrewLink signalling server
Documentation=https://github.com/greluc/AnotherCrewLink-Server
; The server binds to the loopback interface, so it does not need a routable address to
; exist first. network.target is enough; network-online.target would delay boot for a
; guarantee this service does not use.
After=network.target
; The reverse proxy in front of this can start in any order — nginx retries an upstream.

; If it fails five times in a minute, stop trying. These two belong in [Unit]: systemd
; moved them out of [Service] in v229 and ignores them there with a warning, so the
; rate limit would silently do nothing. It prevents a restart loop from
; hiding a configuration error behind an endlessly "starting" service, and prevents a
; crash-on-startup from writing to the journal as fast as the disk allows.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec

; --- identity -------------------------------------------------------------------
; An unprivileged, non-login account that owns nothing but this service. The listening
; port is 9736, above 1024, so no capability is needed to bind it and none is granted.
User=acl
Group=acl

; --- what it runs ---------------------------------------------------------------
; The default PEER_CONFIG path is relative (config/peerConfig.toml), so the working
; directory decides where the peer configuration is read from. Set PEER_CONFIG to an
; absolute path in the environment file if you would rather not depend on this.
WorkingDirectory=/opt/acl-server
ExecStart=/usr/local/bin/acl-server

; --- configuration --------------------------------------------------------------
; The server reads its configuration from the process environment and has no dotfile
; loader, by design. systemd reads this file as root before the sandbox below is
; applied, so the file itself can be root-owned and mode 0640 — the service account
; never needs read access to it.
; The leading '-' means a missing file is not a startup failure: every variable in it
; has a default, and a server that comes up on its defaults is more useful than one that
; refuses to start.
EnvironmentFile=-/etc/acl-server/acl-server.env

; --- privilege ------------------------------------------------------------------
; Prevents this process, or anything it execs, from ever gaining privileges — setuid
; binaries and file capabilities stop working for it. Also a precondition for the system
; call filter below being enforceable.
NoNewPrivileges=yes
; Prevents the process from holding any capability at all. It binds a high port, reads
; two files and talks TCP; there is no capability in that list.
CapabilityBoundingSet=
AmbientCapabilities=
; Prevents a file this process creates from carrying setuid/setgid bits, which is the
; usual way a writable directory turns into a privilege escalation.
RestrictSUIDSGID=yes
; Prevents it from entering or creating namespaces, which is how a sandboxed process
; most often climbs back out of a sandbox.
RestrictNamespaces=yes
; Prevents ADDR_NO_RANDOMIZE and the other personality(2) tricks used to turn off ASLR
; before exploiting something.
LockPersonality=yes
; Prevents mapping a page that is writable and executable at the same time, which is
; what a JIT needs and what shellcode needs. This binary needs neither.
MemoryDenyWriteExecute=yes

; --- filesystem -----------------------------------------------------------------
; Mounts the entire filesystem read-only for this process, with /dev, /proc and /sys
; inaccessible or read-only. It prevents a compromised process from modifying anything
; on the host, including its own binary. The server writes no files — logs go to the
; journal through stdout — so no ReadWritePaths= is needed. If you ever add one, that is
; the moment to ask why the server started writing to disk.
ProtectSystem=strict
; Prevents it from reading /home, /root and /run/user. It has no business there, and
; this is what stops a path traversal in a config value from reaching an SSH key.
ProtectHome=yes
; Gives the process a private, empty /tmp that is destroyed on stop. It prevents both
; leaking temporary files between restarts and being attacked through a predictable name
; another process left in the shared /tmp.
PrivateTmp=yes
; Gives it a minimal /dev with no physical devices — no disks, no raw input devices, no
; /dev/kmem. It prevents reading a block device directly to get around ProtectSystem.
PrivateDevices=yes
; Hides every other process in /proc. It prevents this account from reading another
; service's command line, which is where credentials passed as arguments live.
; Requires systemd 247 or newer; older versions ignore it with a warning.
ProtectProc=invisible
; Prevents writing to /proc/sys, /sys and the kernel's other tunables.
ProtectKernelTunables=yes
; Prevents loading or unloading kernel modules.
ProtectKernelModules=yes
; Prevents reading the kernel log ring buffer, which leaks addresses and hardware detail.
ProtectKernelLogs=yes
; Prevents modifying the cgroup hierarchy, which is how a process escapes its own limits.
ProtectControlGroups=yes
; Prevents changing the system clock. A voice server has no reason to, and a moved clock
; breaks TLS validation and log correlation everywhere else on the host.
ProtectClock=yes
; Prevents files it does create from being readable by anyone but its own account.
UMask=0077

; --- network --------------------------------------------------------------------
; Prevents the process from creating any socket that is not TCP/UDP over IP. It removes
; AF_PACKET (raw frame capture and injection), AF_NETLINK (kernel configuration), and
; the exotic families that are a recurring source of kernel bugs. AF_UNIX stays because
; the C library's name resolution and journal paths use it and removing it buys nothing
; once the two families above are gone.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

; --- system calls ---------------------------------------------------------------
; Restricts the process to the call set an ordinary system service uses, and refuses the
; rest with EPERM. It prevents most kernel-exploit primitives from even being reachable.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
; Prevents entering a second ABI (32-bit calls on a 64-bit kernel) to sidestep the filter
; above, since seccomp filters are per-architecture.
SystemCallArchitectures=native

; --- resource limits ------------------------------------------------------------
; A hard ceiling: the kernel kills the process rather than letting it take the host down
; with it. This is the backstop for the accepted risk recorded in deploy/README.md —
; socketioxide applies no inbound frame cap on the WebSocket transport, so a hostile
; client can make this process allocate, and this turns "the machine dies" into "the
; service restarts". Raise it if a large deployment legitimately needs more; the steady
; state for a few hundred concurrent sockets is tens of megabytes.
MemoryMax=512M
; A soft ceiling below the hard one, so memory pressure shows up as reclaim and a log
; line before the kill. Free early warning.
MemoryHigh=384M
; One file descriptor per connected socket, plus the listener and the epoll set. The
; default of 1024 is a ceiling on concurrent players that presents as random connection
; failures rather than as an error anyone can read.
LimitNOFILE=65536
; This server does not fork. Capping tasks turns a runaway thread spawn into a bounded
; failure and makes a fork bomb from this account impossible.
TasksMax=256

; --- lifecycle ------------------------------------------------------------------
; Restart on a crash or a non-zero exit, but not when an operator stops it deliberately.
Restart=on-failure
RestartSec=2s
; The server closes the socket.io namespaces on SIGTERM and then waits for in-flight HTTP
; requests. The lobby stream is a long-lived response, so give it room; this only bounds
; the pathological case where something does not finish.
TimeoutStopSec=20s
KillMode=mixed

; --- logging --------------------------------------------------------------------
; tracing writes to stdout and stderr; the journal is where they land. Set RUST_LOG in
; the environment file to change the level.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acl-server

[Install]
WantedBy=multi-user.target

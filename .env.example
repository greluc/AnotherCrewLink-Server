# Copy to `.env` next to docker-compose.yml. This is the only file to edit: every coturn
# setting is derived from it, so nothing has to be kept in step by hand any more.

# The hostname clients reach this server on, and the one coturn uses as its realm.
# On a dynamic line this must be a DynDNS name that tracks the current address, with a
# short TTL -- clients are given a name, coturn is given an address, and both have to
# follow the line. See deploy/coturn-dynamic-ip.md.
PUBLIC_HOSTNAME=turn.example.com

# The shared TURN secret, and the reason there is no username or password anywhere.
# coturn takes it as --static-auth-secret; the server derives a per-client, time-limited
# credential from the same value. Nothing to synchronise, nothing shared between players.
#
#     openssl rand -base64 32
TURN_SECRET=changeme

# How long an issued credential is valid. A day by default -- it is handed out once when
# a client connects, so it has to outlive a session, not a request.
#TURN_TTL_SECONDS=86400

# The TURN listening port. 3478 is the standard one and needs no privilege: privileged
# ports are 0-1023, and this is not one of them. It has to match whatever the router
# forwards, and the server advertises this same value to clients.
#TURN_PORT=3478

# The relay port range, one UDP port per active allocation. Deliberately small: every port
# in it has to be forwarded on the router, and a rootless bridged setup pays per port.
# Two hundred is a lot of simultaneous relayed calls for a proximity-chat server.
#TURN_MIN_PORT=49160
#TURN_MAX_PORT=49360

# Leave unset on a dynamic line -- the entrypoint discovers the address. Set it only when
# the line has a fixed public address, and no discovery request is ever made.
#TURN_EXTERNAL_IP=203.0.113.10
#TURN_IP_CHECK_INTERVAL=300

# Copy to ~/.config/acl/acl.env, which both quadlets read. This is the only file to edit:
# every coturn setting is derived from it, so nothing has to be kept in step by hand.
#
# See deploy/quadlet/README.md.

# The hostname clients reach this server on, and the one coturn uses as its realm.
# On a dynamic line this must be a DynDNS name that tracks the current address, with a
# short TTL -- clients are given a name, coturn is given an address, and both have to
# follow the line. See deploy/coturn-dynamic-ip.md.
PUBLIC_HOSTNAME=turn.example.com

# The shared TURN secret, and the reason there is no username or password anywhere.
# coturn takes it as --static-auth-secret; the server derives a per-client, time-limited
# credential from the same value. Nothing to synchronise, nothing shared between players.
#
#     openssl rand -base64 32
TURN_SECRET=changeme

# How long an issued credential is valid. A day by default -- it is handed out once when
# a client connects, so it has to outlive a session, not a request.
#TURN_TTL_SECONDS=86400

# The TURN listening port. 3478 is the standard one and needs no privilege -- privileged
# ports are 0-1023, and this is not one of them. It has to match what the router forwards,
# and the server reads this same variable to decide what to advertise to clients, so the
# two cannot drift apart.
#TURN_PORT=3478

# The relay port range, one UDP port per active allocation. Far smaller than coturn's own
# 49152-65535 default, because every port in it has to be forwarded on the router and a
# rootless bridged setup pays per port. 641 is a great many simultaneous relayed calls for
# a proximity-chat server, and still a range a router will accept as one rule.
#TURN_MIN_PORT=49160
#TURN_MAX_PORT=49800

# Leave unset on a dynamic line -- the entrypoint discovers the address. Set it only when
# the line has a fixed public address, and no discovery request is ever made.
#TURN_EXTERNAL_IP=203.0.113.10
#TURN_IP_CHECK_INTERVAL=300

# The internal address the public one maps to, e.g. the host's LAN address. Set this ONLY if
# you need relay-to-relay to work -- two clients that are both relay-only (which is every
# client when the server sets force_relay_only) relay through the one public address, and
# coturn otherwise refuses a permission for its own address with a 403, so the call never
# connects. Passing the internal address makes coturn map and whitelist it, which fixes that.
#
# The cost, and why it is off by default: whitelisting this address opens it to relay users.
# The relay hands out UDP allocations only, so only UDP services at this address are exposed
# -- check what listens there before setting it. Only this one address opens, never a range,
# so private ranges stay denied and anything on another internal address stays unreachable.
#TURN_INTERNAL_IP=10.0.0.2
